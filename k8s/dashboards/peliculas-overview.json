          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Alertas activas",
      "id": 5,
      "description": "Alertas de k8s/prometheusrule.yaml en estado firing.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
