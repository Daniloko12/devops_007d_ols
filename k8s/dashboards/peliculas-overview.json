      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"Peliculas.*|MySQL.*\"}) or vector(0)",
