# Versiones FIJAS de los charts de Helm del stack de monitoreo.
# Fijarlas hace que tu PC y el pipeline instalen exactamente lo mismo (reproducible y auditable).
# Valores validados en la primera instalación exitosa (helm list -n monitoring, 2026-11-20).
# Para actualizar: cambiar aquí, probar con scripts/local-up.sh y abrir un PR.
KPS_CHART_VERSION=93.6.0          # kube-prometheus-stack (operator v0.95.2)
LOKI_CHART_VERSION=21.4.2         # grafana-community/loki (Loki 3.7.10)
ALLOY_CHART_VERSION=1.16.0        # grafana/alloy (Alloy v1.22.0)
PUSHGATEWAY_CHART_VERSION=3.11.2  # prometheus-pushgateway (v1.11.4)
